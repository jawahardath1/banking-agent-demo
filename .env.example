# Copy to .env. Demo mode needs no AWS account.
AI_MODE=demo
DATABASE_URL=postgresql://demobank:demobank@localhost:5432/demobank
AWS_REGION=us-east-1
# Bedrock mode: set an enabled Claude model or inference profile ID/ARN.
BEDROCK_MODEL_ID=
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Optional temporary credentials. Never commit .env.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Alternative: short-term Bedrock API token. Replace when it expires, then restart backend.
AWS_BEARER_TOKEN_BEDROCK=
